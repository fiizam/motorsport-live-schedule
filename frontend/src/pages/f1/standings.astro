---
import { API_URL } from '../../utils/api';
import Layout from '../../layouts/Layout.astro';
import ChampionshipTable from '../../components/ChampionshipTable.astro';

export const prerender = false;

let standingsData = null;
let error = null;

try {
  const res = await fetch(`${API_URL}/api/f1/standings`);
  if (res.ok) {
    standingsData = await res.json();
  } else {
    error = "Standings data is temporarily unavailable.";
  }
} catch (e) {
  console.error("Failed to fetch F1 standings", e);
  error = "Championship data temporarily unavailable.";
}
---

<Layout title="F1 Drivers Championship">
  <div class="pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-editorial animate-fade-up">
    <div class="flex items-center space-x-3 mb-6">
      <span class="text-f1-red font-bold text-sm tracking-widest uppercase font-sans">Formula 1</span>
      <span class="w-1 h-1 bg-surface-800 rounded-full"></span>
      <span class="text-text-secondary text-sm tracking-widest uppercase font-sans">2026</span>
    </div>
    
    <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter leading-[0.85] uppercase text-text-primary">
      Drivers<br/>Championship
    </h1>
  </div>

  {error ? (
    <div class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-fade-up">
      <p class="text-xl text-text-secondary font-heading tracking-wide uppercase">{error}</p>
    </div>
  ) : standingsData && standingsData.drivers && standingsData.drivers.length > 0 ? (
    <div class="py-8">
      <ChampionshipTable title="" standings={standingsData.drivers} accentColorClass="text-f1-red" />
    </div>
  ) : (
    <div class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-fade-up">
      <p class="text-xl text-text-secondary font-heading tracking-wide uppercase">No championship data available yet.</p>
    </div>
  )}
</Layout>
