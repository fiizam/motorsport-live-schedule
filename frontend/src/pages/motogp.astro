---
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400');
import { API_URL } from '../utils/api';
import Layout from '../layouts/Layout.astro';
import ChampionshipSwitcher from '../components/ChampionshipSwitcher.svelte';

import { formatEventDay, formatEventMonth } from '../utils/timeUtils';

let calendar = [];
let error = null;
let currentYear = new Date().getFullYear();

try {
  const res = await fetch(`${API_URL}/api/motogp/calendar`);
  if (res.ok) {
    calendar = await res.json();
  } else {
    error = "Failed to load the MotoGP calendar.";
  }
} catch (e) {
  console.error("Failed to fetch MotoGP calendar", e);
  error = "Live schedule is temporarily unavailable.";
}
---

<Layout title="MotoGP Calendar" description="Complete MotoGP race calendar and schedules">
  <div class="min-h-screen pt-24 pb-32 bg-surface-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-24 animate-fade-up">
        <div>
          <div class="mb-8">
            <ChampionshipSwitcher client:load current="motogp" />
          </div>
          <h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase mb-4 text-text-primary leading-none">
            MotoGP
          </h1>
          <p class="text-text-secondary text-xl font-heading tracking-wide uppercase">
            {currentYear} Season Calendar
          </p>
        </div>
      </div>

      {error ? (
        <div class="glass-panel border-red-500/30 text-red-500 px-6 py-4 rounded animate-fade-up">
          {error}
        </div>
      ) : (
        <div class="relative border-l border-editorial ml-4 md:ml-12">
          {calendar.map((event: any, index: number) => {
            // Find main race date strictly by type
            const raceSession = event.sessions.find((s: any) => s.type === 'Race');
            const isFinished = raceSession?.status === 'FINISHED';
            
            // Only format if valid session exists
            if (!raceSession) return null;
            
            let month = 'TBD';
            let day = '--';
            try {
              month = formatEventMonth(raceSession.startDate);
              day = formatEventDay(raceSession.startDate);
            } catch (e) {
              console.error("Format error on calendar card:", e);
            }
            
            const cardOpacity = isFinished ? 'opacity-60 hover:opacity-100' : 'opacity-100';

            return (
              <a href={`/motogp/${event.round}`} class={`block group relative pl-8 md:pl-16 py-12 border-b border-editorial animate-fade-up ${cardOpacity} transition-opacity duration-300`} style={`animation-delay: ${index * 50}ms;`}>
                
                <!-- Timeline Marker -->
                <div class="absolute left-0 top-16 -translate-x-1/2 w-4 h-4 rounded-full bg-white border-2 border-editorial group-hover:border-motogp-blue transition-colors duration-300">
                  <div class="absolute inset-[3px] bg-transparent rounded-full group-hover:bg-motogp-blue transition-colors duration-300"></div>
                </div>

                <div class="flex flex-col md:flex-row gap-8">
                  
                  <!-- Date Block -->
                  <div class="flex flex-col min-w-[100px] shrink-0">
                    <span class="text-xs font-bold text-motogp-blue uppercase tracking-widest mb-2 font-sans">
                      Round {event.round}
                    </span>
                    <span class="text-5xl font-bold tracking-tighter tabular-nums font-sans leading-none text-text-primary transition-colors duration-300">
                      {day}
                    </span>
                    <span class="text-lg font-bold text-text-tertiary tracking-widest uppercase mt-1 font-sans">
                      {month}
                    </span>
                  </div>
                  
                  <!-- Info Block -->
                  <div class="flex flex-col justify-center w-full">
                    <div class="flex items-center flex-wrap gap-3 mb-2">
                      <h2 class="text-3xl md:text-5xl font-black tracking-tighter uppercase transition-colors text-text-primary">
                        {event.name}
                      </h2>
                      {isFinished && (
                         <span class="px-2 py-0.5 border border-motogp-blue/20 text-motogp-blue text-[10px] uppercase tracking-widest font-bold bg-motogp-blue/5 rounded ml-2">Result</span>
                      )}
                      {!isFinished && (
                         <span class="px-2 py-0.5 border border-editorial text-text-secondary text-[10px] uppercase tracking-widest font-bold bg-surface-100 rounded ml-2">Upcoming</span>
                      )}
                    </div>
                    
                    <div class="flex flex-col space-y-1">
                      <span class="text-lg font-light text-text-secondary uppercase tracking-widest font-heading">
                        {event.circuit}
                      </span>
                      <span class="text-sm font-bold text-text-tertiary uppercase tracking-widest font-sans">
                        {event.country || "Location"}
                      </span>
                    </div>
                  </div>
                  
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>
</Layout>
