---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Standings" description="Current Championship Standings">
  <div class="bg-surface-50 min-h-screen py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter mb-2">Standings</h1>
        <p class="text-gray-500 text-lg">Championship rankings</p>
      </div>
      <div class="glass-panel p-8 rounded-3xl text-center">
        <p class="text-gray-500">Live standings integration coming soon...</p>
      </div>
    </div>
  </div>
</Layout>
