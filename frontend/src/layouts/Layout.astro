---
import { ClientRouter } from 'astro:transitions';
import SplashScreen from '../components/SplashScreen.astro';
import PullToRefresh from '../components/PullToRefresh.svelte';
import DarkModeToggle from '../components/DarkModeToggle.svelte';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Real-Time Formula 1 & MotoGP Schedule Platform" } = Astro.props;
const pathname = Astro.url.pathname;
const isF1 = pathname.startsWith('/f1');
const isMotoGP = pathname.startsWith('/motogp');
const isStandings = pathname.endsWith('standings') || pathname.endsWith('standings/');
const isCalendar = !isStandings && (isF1 || isMotoGP);

const accentColor = isF1 ? 'text-f1-red border-f1-red' : (isMotoGP ? 'text-motogp-blue border-motogp-blue' : 'text-text-primary border-text-primary');
const basePath = isF1 ? '/f1' : (isMotoGP ? '/motogp' : '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Motorsport</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    
    <!-- SEO and Social tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Motorsport Platform",
        "url": "https://motorsport-platform.com/"
      }
    </script>
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => {
            console.error('ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>

    <!-- Prevent FOUC for Dark Mode -->
    <script is:inline>
      (function() {
        try {
          var savedTheme = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    
    <!-- Google Fonts: Outfit (Headings) & Inter (Data/Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700;900&display=swap" rel="stylesheet">
    
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-surface-50 text-text-primary selection:bg-black selection:text-white pb-24 md:pb-0">
    <PullToRefresh client:load />
    <SplashScreen />
    <!-- Top Navbar -->
    <nav class="sticky top-0 z-40 bg-surface-50/90 backdrop-blur-md border-b border-editorial">
      <!-- Navigation Progress Bar -->
      <div id="nav-loader" class="absolute bottom-0 left-0 h-[2px] bg-f1-red w-0 opacity-0 transition-all duration-300 z-50 pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <div class="flex items-center space-x-8">
          <a href="/" class="text-xl font-bold tracking-tighter uppercase font-heading hover:opacity-70 transition-opacity">Motorsport</a>
          
          <div class="hidden md:flex items-center space-x-1">
            <a href="/f1" class={`px-3 py-1.5 text-xs uppercase tracking-widest font-bold rounded-sm transition-colors ${isF1 ? 'bg-text-primary text-surface-50' : 'text-text-secondary hover:text-text-primary'}`}>
              F1
            </a>
            <a href="/motogp" class={`px-3 py-1.5 text-xs uppercase tracking-widest font-bold rounded-sm transition-colors ${isMotoGP ? 'bg-text-primary text-surface-50' : 'text-text-secondary hover:text-text-primary'}`}>
              MotoGP
            </a>
          </div>
        </div>
        
        <!-- Contextual Links & Dark Mode -->
        <div class="flex items-center space-x-4 sm:space-x-6 h-full">
          {(isF1 || isMotoGP) && (
            <>
              <a href={basePath} class={`text-[10px] sm:text-xs uppercase tracking-widest font-bold transition-colors h-full flex items-center border-b-2 ${isCalendar ? accentColor : 'text-text-secondary border-transparent hover:text-text-primary'}`}>
                Calendar
              </a>
              <a href={`${basePath}/standings`} class={`text-[10px] sm:text-xs uppercase tracking-widest font-bold transition-colors h-full flex items-center border-b-2 ${isStandings ? accentColor : 'text-text-secondary border-transparent hover:text-text-primary'}`}>
                Standings
              </a>
            </>
          )}
          <div class="pl-2">
            <DarkModeToggle client:load />
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile Floating Bottom Navbar -->
    <nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-sm bg-surface-50/90 backdrop-blur-xl border border-editorial shadow-2xl rounded-full px-6 py-4 flex items-center justify-around md:hidden">
      <a href="/" class="flex flex-col items-center group">
        <svg class={`w-5 h-5 mb-1 ${pathname === '/' ? 'text-text-primary' : 'text-text-tertiary group-hover:text-text-primary'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class={`text-[10px] uppercase tracking-widest font-bold ${pathname === '/' ? 'text-text-primary' : 'text-text-tertiary group-hover:text-text-primary'}`}>Home</span>
      </a>
      <a href="/f1" class="flex flex-col items-center group">
        <svg class={`w-5 h-5 mb-1 ${isF1 ? 'text-f1-red' : 'text-text-tertiary group-hover:text-f1-red'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class={`text-[10px] uppercase tracking-widest font-bold ${isF1 ? 'text-f1-red' : 'text-text-tertiary group-hover:text-f1-red'}`}>F1</span>
      </a>
      <a href="/motogp" class="flex flex-col items-center group">
        <svg class={`w-5 h-5 mb-1 ${isMotoGP ? 'text-motogp-blue' : 'text-text-tertiary group-hover:text-motogp-blue'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
        <span class={`text-[10px] uppercase tracking-widest font-bold ${isMotoGP ? 'text-motogp-blue' : 'text-text-tertiary group-hover:text-motogp-blue'}`}>MotoGP</span>
      </a>
    </nav>

    <main class="flex-grow bg-surface-50">
      <slot />
    </main>

    <footer class="bg-surface-50 border-t border-editorial py-16 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center text-center">
        <span class="text-2xl font-bold tracking-tighter uppercase font-heading block mb-2">Motorsport</span>
        <p class="text-xs text-text-secondary tracking-widest uppercase mb-8">Precision Real-Time Data</p>
        
        <a href="/Motorsport.apk" download class="hide-in-app group flex items-center justify-center space-x-3 bg-text-primary text-surface-50 hover:opacity-80 px-8 py-4 rounded-full transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-2xl">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <!-- Android Logo SVG -->
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592c.1158-.201.0466-.4576-.1544-.5735-.2008-.1158-.4576-.0466-.5735.1544l-2.0409 3.535C15.5413 8.2144 13.8407 7.7126 12 7.7126s-3.5413.5018-5.1102 1.265L4.8489 5.4426c-.1158-.201-.3727-.2702-.5735-.1544-.201.1158-.2702.3725-.1544.5735l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.102-2.6889-7.5743-6.1185-9.44z"/>
          </svg>
          <div class="flex flex-col items-start text-left">
            <span class="text-[10px] uppercase tracking-widest text-gray-300 font-medium">Download untuk Android</span>
            <span class="text-sm font-bold font-heading uppercase tracking-wider">Install Aplikasi (.APK)</span>
          </div>
        </a>
        <p class="hide-in-app text-[10px] text-text-tertiary mt-4 max-w-sm">Setelah men-download, pastikan Anda memberikan izin "Install Unknown Apps" pada pengaturan HP Anda.</p>
      </div>
    </footer>

    <script>
      // Page Navigation Loading Bar Logic
      document.addEventListener('astro:before-preparation', () => {
        const loader = document.getElementById('nav-loader');
        if (loader) {
          loader.style.transition = 'width 0.4s ease-out, opacity 0.2s';
          loader.style.opacity = '1';
          loader.style.width = '40%';
          
          // simulate progressing slowly while waiting
          window._navLoaderTimeout = setTimeout(() => {
            if (loader.style.opacity === '1') loader.style.width = '75%';
          }, 400);
        }
      });
      
      document.addEventListener('astro:page-load', () => {
        const loader = document.getElementById('nav-loader');
        if (loader) {
          clearTimeout(window._navLoaderTimeout);
          loader.style.width = '100%';
          
          setTimeout(() => {
            loader.style.opacity = '0';
            setTimeout(() => {
              loader.style.transition = 'none'; // remove transition to reset instantly
              loader.style.width = '0';
            }, 300);
          }, 400);
        }
      });
    </script>
  </body>
</html>
