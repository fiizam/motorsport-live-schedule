{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/circuits/?$",
			"dest": "_render"
		},
		{
			"src": "^/drivers/?$",
			"dest": "_render"
		},
		{
			"src": "^/f1/standings/?$",
			"dest": "_render"
		},
		{
			"src": "^/f1/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/f1/?$",
			"dest": "_render"
		},
		{
			"src": "^/motogp/standings/?$",
			"dest": "_render"
		},
		{
			"src": "^/motogp/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/motogp/?$",
			"dest": "_render"
		},
		{
			"src": "^/standings/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}